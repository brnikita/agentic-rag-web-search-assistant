# Required: Claude chat model
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables the web_search tool. Without it the agent runs docs-only.
TAVILY_API_KEY=tvly-...

# Optional overrides (defaults shown)
# MODEL=claude-opus-5
# MAX_TOKENS=8000
# THINKING=adaptive          # or "off"
# DOCS_DIR=./docs
# VECTOR_STORE_DIR=./.chroma
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# DOCS_SEARCH_K=4
# WEB_SEARCH_MAX_RESULTS=5

# Optional: tracing at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=provectus-agentic-task
