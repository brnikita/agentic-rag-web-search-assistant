# Required for the LLM (read directly by the Anthropic SDK, not AGENT_-prefixed)
ANTHROPIC_API_KEY=sk-ant-...

# Required only when AGENT_TOOL_MODE=real
TAVILY_API_KEY=tvly-...

# --- Agent settings (all optional; defaults shown) --------------------------
# AGENT_MODEL_NAME=claude-sonnet-4-6
# AGENT_TEMPERATURE=0.0
# AGENT_MAX_TOKENS=8000

# Circuit breakers
# AGENT_MAX_TOOL_CALLS_PER_TURN=4
# AGENT_MAX_TOOL_CALLS_PER_THREAD=40
# AGENT_MAX_ERROR_COUNT=2
# AGENT_TOOL_TIMEOUT_S=10.0
# AGENT_RETRY_ATTEMPTS=3

# Retrieval. "mock" needs no keys and no infrastructure.
# AGENT_TOOL_MODE=mock          # mock | real
# AGENT_RAG_TOP_K=4
# AGENT_WEB_TOP_K=3

# Graph
# AGENT_CHECKPOINTER=memory     # memory | postgres
# AGENT_POSTGRES_DSN=postgresql://user:pass@localhost:5432/agent
# AGENT_RECURSION_LIMIT=25

# Optional tracing at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
